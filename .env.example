# SKYTICAL Copilot is off unless both the build and Actions worker receive true.
SKYTICAL_COPILOT_ENABLED=false

# Private Beta limits. The GitHub Pages transport can rate-limit only the
# authenticated repository owner identity, not the visitor IP address.
AI_RATE_LIMIT_PER_MINUTE=8
AI_DAILY_REQUEST_LIMIT=50
AI_EXTERNAL_SEARCH_DAILY_LIMIT=10
AI_DAILY_BUDGET_LIMIT_USD=5

# Copilot reuses AVWIRE_MANUAL_TOKEN for job encryption and the repository's
# existing provider keys. Never commit real values.
AVWIRE_MANUAL_TOKEN=
OPENCODE_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
